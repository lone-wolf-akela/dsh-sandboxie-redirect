# Runtime logs. The plugin writes provider.log / host.log / tool.log; they carry
# local paths and machine state, so they are never part of the repository.
*.log

# Local extraction aid for test/validate-patch.mjs (js-yaml taken out of the
# installed harness). Regenerate locally instead of committing.
/asar-yaml/

# Install/dependency trees and scratch directories.
node_modules/
/.recon/

# Packed artifacts (`npm pack` / `pnpm pack` leave these at the repo root).
*.tgz

# Editor and OS noise.
.DS_Store
Thumbs.db
*.swp
